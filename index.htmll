  }  
.deal-top{position:relative}.deal-image{width:100%;aspect-ratio:16/7;object-fit:cover}
.deal-badge{position:absolute;top:18px;right:18px;background:rgba(6,28,21,.9);color:#f7e7b4;padding:9px 15px;border-radius:999px;font-weight:700;font-size:12px}
.deal-body{padding:26px}.deal-title{font-family:'Playfair Display',Cairo,serif;font-size:30px;font-weight:700}.deal-desc{color:var(--muted);line-height:1.9}
.prices{display:flex;gap:13px;align-items:center;flex-wrap:wrap}.old{text-decoration:line-through;color:#9b9b95}.new{font-size:32px;font-weight:700;color:var(--green2)}
.discount{background:var(--green);color:#fff;padding:6px 11px;border-radius:999px;font-size:12px}
.timer{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.timer div{background:var(--green);color:white;text-align:center;border-radius:16px;padding:10px}.timer b{display:block;font-size:27px}
.deal-order,.product button,.full{width:100%;background:var(--green);color:white;padding:14px;border-radius:14px;font-weight:700}
.search input{width:100%;padding:15px 18px;border:1px solid var(--line);border-radius:16px;background:rgba(255,253,248,.85);outline:0}
.categories{display:flex;gap:10px;overflow:auto;padding:15px 0}.cat{background:var(--ivory);border:1px solid var(--line);border-radius:17px;padding:8px;min-width:104px;color:var(--green)}.cat img{width:72px;height:72px;object-fit:cover;border-radius:13px}.cat strong{display:block;font-size:12px;margin-top:3px}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product{
  background:#fff;
  border:1px solid #e5dfd2;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 3px 12px rgba(17,43,34,.08);
  transition:.2s;
  position:relative;
}

.product:hover{
  transform:translateY(-3px);
  box-shadow:0 10px 28px rgba(17,43,34,.14);
}

.product>img{
  width:100%;
  aspect-ratio:1/1;
  object-fit:cover;
  display:block;
  cursor:pointer;
}

.product-body{
  padding:13px 14px 15px;
  text-align:right;
}

.product-body h3{
  font-size:14px;
  line-height:1.6;
  margin:0;
  color:#092d22;
  min-height:44px;
}

.product-body .price{
  font-size:21px;
  color:#092d22;
  font-weight:800;
  margin:7px 0 10px;
}

.product-qty{
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:#f7f3e9;
  border:1px solid #e5dfd2;
  border-radius:10px;
  padding:3px;
  margin-top:8px;
}

.product-qty button{
  width:34px!important;
  height:32px;
  padding:0!important;
  border-radius:8px!important;
  background:#092d22!important;
  color:#fff!important;
}

.product-qty span{
  font-weight:800;
  color:#092d22;
}

.product-body>button{
  width:100%;
  margin-top:9px;
  padding:11px!important;
  border-radius:10px!important;
  background:#08783f!important;
  color:#fff!important;
  font-weight:800;
}

.product-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
  margin-top:7px;
}

.product-actions button{
  padding:9px 5px!important;
  border-radius:9px!important;
  font-size:11px!important;
}

.product-actions .details-btn{
  background:#f1ede3!important;
  color:#092d22!important;
}

.product-actions .share-btn{
  background:#fff!important;
  color:#092d22!important;
  border:1px solid #e5dfd2!important;
}

@media(max-width:600px){
  .products{
    grid-template-columns:repeat(2,1fr);
    gap:10px;
  }

  .product{
    border-radius:12px;
  }

  .product-body{
    padding:10px;
  }

  .product-body h3{
    font-size:12px;
    min-height:39px;
  }

  .product-body .price{
    font-size:17px;
  }
  }
.articles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.article{background:var(--ivory);border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 12px 35px rgba(17,43,34,.06)}.article img{width:100%;aspect-ratio:3/2;object-fit:cover}.article-body{padding:17px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:100;display:flex;align-items:center;justify-content:center;padding:15px}.hidden{display:none!important}.box{background:var(--ivory);width:min(700px,100%);max-height:90vh;overflow:auto;border-radius:26px;padding:22px;border:1px solid var(--line)}.close{float:left;border-radius:50%;padding:5px 12px;background:#eee8db}
.cart-item{display:flex;gap:10px;align-items:center;border-bottom:1px solid var(--line);padding:12px 0}.cart-item img{width:62px;height:62px;object-fit:cover;border-radius:12px}.info{flex:1}.qty{display:flex;gap:7px;align-items:center}.qty button{background:var(--green);color:white;border-radius:9px;padding:5px 10px}
.form input,.form textarea{width:100%;padding:13px;margin:5px 0;border:1px solid var(--line);border-radius:12px;background:#fff}.total{background:#f1ecdf;padding:16px;border-radius:16px;margin:15px 0;line-height:2}
.upsell-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.upsell-item{border:1px solid var(--line);border-radius:17px;overflow:hidden;background:#fff}.upsell-item img{width:100%;aspect-ratio:1;object-fit:cover}.upsell-item div{padding:10px}.upsell-add{width:100%;background:var(--green);color:white;padding:9px;border-radius:10px}
.free-msg{background:#e8f2eb;padding:12px;border-radius:12px;margin:10px 0;font-weight:700}.gift-msg{background:#fbf0cc;padding:12px;border-radius:12px;margin:10px 0;font-weight:700}
footer{background:var(--deep);color:white;text-align:center;padding:50px 20px;margin-top:70px;border-top:1px solid rgba(201,168,91,.25)}footer h2{font-family:'Playfair Display',serif;color:#e0c77e}
.bottom{position:fixed;bottom:0;left:0;right:0;background:rgba(255,253,248,.96);backdrop-filter:blur(14px);border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:9px;z-index:60}.bottom a{color:var(--green);text-decoration:none;text-align:center;font-size:11px;font-weight:700}
@media(max-width:900px){.benefits{grid-template-columns:1fr 1fr}.products{grid-template-columns:repeat(2,1fr)}.articles{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.hero{height:72vh;min-height:420px}.nav{gap:9px}.brand b{font-size:12px}.cart-btn{padding:9px 12px;font-size:12px}.section{margin:42px auto;padding:0 13px}.section h2{font-size:28px}.deals-head h2{font-size:32px}.deal-card{border-radius:24px}.deal-image{aspect-ratio:4/3}.deal-body{padding:20px}.products{gap:11px}.product{border-radius:18px}.product-body{padding:12px}.product-body h3{font-size:13px}.price{font-size:18px}.upsell-list{grid-template-columns:1fr 1fr}.upsell-item:last-child{display:none}}

.product-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.product-actions button{padding:10px 8px!important;font-size:12px!important;border-radius:12px!important}
.product-actions .details-btn{background:#eee8db!important;color:var(--green)!important}
.product-actions .share-btn{background:transparent!important;color:var(--green)!important;border:1px solid var(--line)!important}
.product-qty{display:flex;align-items:center;justify-content:space-between;background:#f4efe5;border:1px solid var(--line);border-radius:12px;padding:4px;margin-top:10px}
.product-qty button{width:36px!important;height:34px;padding:0!important;border-radius:9px!important}
.product-qty span{font-weight:700;min-width:30px;text-align:center}
.detail-image{width:100%;max-height:430px;object-fit:cover;border-radius:18px;margin-bottom:15px}
.detail-price{font-size:28px;font-weight:700;color:var(--green2);margin:8px 0}
.detail-info{line-height:2;color:#5f6d66}
.detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}
.share-copy{background:var(--green);color:#fff;padding:13px;border-radius:13px;font-weight:700;width:100%}
@media(max-width:600px){.product-actions{grid-template-columns:1fr 1fr}.product-qty button{width:32px!important}}

.doctor-launch{
  position:fixed;right:16px;bottom:78px;z-index:70;
  width:72px;height:72px;border-radius:50%;overflow:hidden;
  border:3px solid var(--gold2);background:var(--deep);
  box-shadow:0 10px 30px rgba(6,28,21,.28);
  padding:0;transition:.2s
}
.doctor-launch:hover{transform:translateY(-3px) scale(1.03)}
.doctor-launch img{width:100%;height:100%;object-fit:cover}
.doctor-launch span{
  position:absolute;right:-4px;top:-7px;background:var(--gold);
  color:var(--green);font-size:9px;font-weight:800;padding:3px 6px;
  border-radius:999px;border:2px solid var(--ivory)
}
.doctor-brand{
  display:flex;align-items:center;gap:12px;margin-bottom:14px
}
.doctor-brand img{width:58px;height:58px;border-radius:16px;object-fit:cover;border:1px solid var(--line)}
.doctor-note{
  background:#f5f0e5;border:1px solid var(--line);padding:12px;
  border-radius:14px;line-height:1.9;color:#5f6d66;margin-top:12px
}
@media(max-width:600px){.doctor-launch{width:64px;height:64px;right:12px;bottom:72px}}


.doctor-analyze-btn{
  width:100%;margin-top:16px;padding:15px 18px;border:0;border-radius:15px;
  background:linear-gradient(135deg,var(--green),var(--green2));
  color:#fff;font-weight:800;font-size:17px;cursor:pointer;
  box-shadow:0 8px 20px rgba(6,28,21,.18)
}
.doctor-analyze-btn:disabled{opacity:.55;cursor:not-allowed}
.doctor-status{margin-top:12px;text-align:center;line-height:1.8;color:#53665d;font-size:14px}



  .gm-category-strip{
  display:flex!important;
  gap:16px!important;
  overflow-x:auto!important;
  padding:18px 4px!important;
  scrollbar-width:none;
}

.gm-category-strip::-webkit-scrollbar{
  display:none;
}

.gm-category-strip .cat{
  flex:0 0 115px;
  min-width:115px!important;
  height:125px;
  padding:10px!important;
  background:#fff!important;
  border:1px solid #e5dfd2!important;
  border-radius:18px!important;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  box-shadow:0 5px 18px rgba(17,43,34,.07);
  transition:.2s;
}

.gm-category-strip .cat:hover{
  transform:translateY(-3px);
  border-color:#c9a85b!important;
  box-shadow:0 10px 25px rgba(17,43,34,.12);
}

.gm-category-strip .cat img{
  width:76px!important;
  height:76px!important;
  border-radius:50%!important;
  object-fit:cover;
  border:2px solid #f0eadc;
}

.gm-category-strip .cat strong{
  margin-top:7px!important;
  font-size:11px!important;
  color:#092d22;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  max-width:100%;
}

.gm-category-strip .cat:first-child{
  background:#092d22!important;
  color:#fff!important;
}

.gm-category-strip .cat:first-child strong{
  color:#fff!important;
}

@media(max-width:600px){
  .gm-category-strip{
    gap:10px!important;
    padding:14px 2px!important;
  }

  .gm-category-strip .cat{
    flex-basis:92px;
    min-width:92px!important;
    height:105px;
    border-radius:15px!important;
  }

  .gm-category-strip .cat img{
    width:62px!important;
    height:62px!important;
  }

  .gm-category-strip .cat strong{
    font-size:10px!important;
  }
}
.gm-amazon-header{
  background:#061c15;
  color:#fff;
  font-family:Cairo,Tahoma,sans-serif;
  position:sticky;
  top:0;
  z-index:90;
  box-shadow:0 4px 18px rgba(0,0,0,.18);
}
.gm-topbar{
  height:38px;
  background:#092d22;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 28px;
  font-size:12px;
  color:#f4f1e8;
}
.gm-topbar span{margin-left:22px}
.gm-mainbar{
  max-width:1400px;
  margin:auto;
  min-height:112px;
  display:flex;
  align-items:center;
  gap:28px;
  padding:14px 22px;
}
.gm-brand{
  display:flex;
  align-items:center;
  gap:14px;
  min-width:340px;
}
.gm-brand-logo{
  width:76px;
  height:76px;
  border-radius:50%;
  object-fit:cover;
  border:2px solid #e0c77e;
  box-shadow:0 5px 18px rgba(0,0,0,.25);
}
.gm-brand-text{
  line-height:1.05;
}
.gm-brand-name{
  display:block;
  font-family:'Playfair Display',Cairo,serif;
  font-size:27px;
  font-weight:700;
  color:#fff;
}
.gm-owner{
  display:block;
  color:#e0c77e;
  font-family:'Playfair Display',Cairo,serif;
  font-size:17px;
  margin-top:7px;
}
.gm-tagline{
  display:block;
  color:#c6d1ca;
  font-size:11px;
  margin-top:6px;
}
.gm-search{
  flex:1;
  max-width:600px;
  height:50px;
  display:flex;
  background:#fff;
  border-radius:9px;
  overflow:hidden;
  direction:rtl;
}
.gm-search input{
  flex:1;
  border:0!important;
  outline:0!important;
  padding:0 20px!important;
  font-family:Cairo,Tahoma,sans-serif;
  font-size:14px;
  background:#fff!important;
  margin:0!important;
}
.gm-search button{
  width:58px;
  background:#e0c77e;
  color:#092d22;
  font-size:25px;
  font-weight:700;
}
.gm-head-actions{
  display:flex;
  align-items:center;
  gap:24px;
  white-space:nowrap;
}
.gm-head-action{
  color:#fff;
  background:transparent;
  font-size:13px;
  text-align:center;
  padding:4px;
}
.gm-head-action .ico{
  display:block;
  font-size:27px;
  line-height:1;
  margin-bottom:5px;
}
.gm-cart-count{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:22px;
  height:22px;
  border-radius:50%;
  background:#e51d2a;
  color:#fff;
  font-size:11px;
  position:relative;
  top:-25px;
  right:-7px;
}
.gm-nav{
  background:#0d4935;
  border-top:1px solid rgba(224,199,126,.15);
}
.gm-nav-inner{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:20px;
  margin-bottom:20px;
  padding-bottom:14px;
  border-bottom:1px solid #e5dfd2;
}

.gm-products-kicker{
  display:block;
  color:#c9a85b;
  font-size:10px;
  font-weight:800;
  letter-spacing:1.5px;
  margin-bottom:4px;
}

.gm-products-head h2{
  margin:0!important;
  color:#092d22;
  font-family:Cairo,Tahoma,sans-serif!important;
  font-size:28px!important;
  font-weight:800;
}

.gm-products-head p{
  margin:4px 0 0;
  color:#78857e;
  font-size:12px;
}

.gm-view-all{
  flex-shrink:0;
  color:#08783f;
  text-decoration:none;
  font-size:13px;
  font-weight:800;
  padding:9px 14px;
  border:1px solid #d8dfd9;
  border-radius:8px;
  background:#fff;
}

.gm-view-all:hover{
  background:#edf4ef;
}

@media(max-width:600px){
  .gm-products-head{
    align-items:flex-end;
    margin-bottom:14px;
  }

  .gm-products-head h2{
    font-size:20px!important;
  }

  .gm-products-head p{
    font-size:10px;
  }

  .gm-view-all{
    font-size:10px;
    padding:7px 10px;
  }
  }
  max-width:1400px;
  margin:auto;
  display:flex;
  align-items:center;
  overflow:auto;
  padding:0 20px;
}
.gm-nav a,.gm-nav button{
  color:#fff;
  text-decoration:none;
  background:transparent;
  padding:15px 20px;
  font-weight:700;
  font-size:13px;
  white-space:nowrap;
}
.gm-nav a:hover,.gm-nav button:hover{
  background:#126044;
}
.gm-all{
  background:#126044!important;
}
@media(max-width:800px){
  .gm-topbar{display:none}
  .gm-mainbar{
    min-height:auto;
    padding:10px 12px;
    gap:10px;
    flex-wrap:wrap;
  }
  .gm-brand{
    min-width:0;
    flex:1;
    order:1;
  }
  .gm-brand-logo{
    width:52px;
    height:52px;
  }
  .gm-brand-name{font-size:17px}
  .gm-owner{font-size:12px;margin-top:4px}
  .gm-tagline{font-size:9px;margin-top:3px}
  .gm-head-actions{order:2;gap:5px}
  .gm-head-action{font-size:9px}
  .gm-head-action .ico{font-size:21px}
  .gm-search{
    order:3;
    flex-basis:100%;
    max-width:none;
    height:44px;
  }
  .gm-nav-inner{padding:0 8px}
  .gm-nav a,.gm-nav button{
    padding:12px 13px;
    font-size:11px;
  }
}


.gm-hero{
  position:relative;
  width:100%;
  height:420px;
  overflow:hidden;
  background:#071d16;
}
.gm-hero img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  filter:saturate(.95) contrast(1.04);
}
.gm-hero-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      90deg,
      rgba(3,22,15,.82) 0%,
      rgba(3,22,15,.48) 38%,
      rgba(3,22,15,.08) 72%
    );
}
.gm-hero-content{
  position:relative;
  z-index:2;
  height:100%;
  max-width:1400px;
  margin:auto;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:flex-start;
  padding:40px 70px;
  color:#fff;
  text-align:right;
}
.gm-hero-content h1{
  margin:0 0 8px;
  max-width:560px;
  font-family:'Playfair Display',Cairo,serif;
  font-size:48px;
  line-height:1.25;
  font-weight:700;
}
.gm-hero-content h1::first-letter{
  color:#e0c77e;
}
.gm-hero-content p{
  margin:0 0 22px;
  max-width:500px;
  font-size:20px;
  line-height:1.8;
  color:#f5f0e5;
}
.gm-hero-btn{
  display:inline-flex;
  align-items:center;
  gap:10px;
  background:linear-gradient(135deg,#e0c77e,#c9a85b);
  color:#092d22;
  padding:13px 28px;
  border-radius:999px;
  font-weight:800;
  font-size:16px;
  text-decoration:none;
  box-shadow:0 8px 25px rgba(0,0,0,.2);
}
.gm-hero-dots{
  position:absolute;
  bottom:18px;
  left:70px;
  z-index:3;
  display:flex;
  gap:8px;
}
.gm-hero-dots span{
  width:11px;
  height:11px;
  border-radius:50%;
  background:rgba(255,255,255,.55);
}
.gm-hero-dots span.active{
  background:#fff;
}
@media(max-width:600px){
  .gm-hero{
    height:430px;
  }
  .gm-hero-content{
    padding:30px 24px;
    justify-content:flex-end;
    padding-bottom:55px;
  }
  .gm-hero-content h1{
    font-size:32px;
    max-width:90%;
  }
  .gm-hero-content p{
    font-size:15px;
    max-width:90%;
  }
  .gm-hero-btn{
    font-size:14px;
    padding:11px 22px;
  }
  .gm-hero-dots{
    left:24px;
    bottom:18px;
  }
}

.gm-benefits{max-width:1400px;margin:0 auto;padding:24px 18px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;background:var(--cream)}
.gm-benefits-inner{display:contents}.gm-benefit{background:#fffdf8;border:1px solid var(--line);border-radius:18px;padding:16px;display:flex;align-items:center;gap:12px;box-shadow:0 6px 20px rgba(17,43,34,.06)}.gm-benefit-icon{font-size:30px;min-width:38px;text-align:center}.gm-benefit-text b{display:block;font-size:13px;color:var(--green)}.gm-benefit-text small{display:block;color:var(--muted);font-size:10px;margin-top:3px}
.gm-doctor-card{max-width:1280px;margin:0 auto;padding:35px;border-radius:24px;background:linear-gradient(135deg,#073c27,#0b5b3d);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:35px;overflow:hidden;position:relative;box-shadow:0 12px 35px rgba(7,60,39,.18)}.gm-doctor-content{flex:1}.gm-doctor-kicker{display:block;color:#d5b86a;font-size:11px;font-weight:800;letter-spacing:2px;margin-bottom:8px}.gm-doctor-content h2{margin:0;font-size:32px;font-weight:900}.gm-doctor-title{margin:5px 0 12px;color:#d5b86a;font-size:18px;font-weight:800}.gm-doctor-text{max-width:600px;color:#e8f1ec;line-height:1.9;font-size:14px}.gm-doctor-btn{margin-top:12px;padding:13px 22px;border:0;border-radius:10px;background:#d5b86a;color:#073c27;font-weight:900;cursor:pointer}.gm-doctor-image{width:250px;min-width:250px;text-align:center;position:relative}.gm-doctor-image img{width:210px;height:210px;object-fit:cover;border-radius:50%;border:5px solid rgba(213,184,106,.7);box-shadow:0 10px 30px rgba(0,0,0,.25)}.gm-doctor-badge{margin-top:-18px;position:relative;display:inline-block;background:#fff;color:#073c27;padding:7px 12px;border-radius:20px;font-size:11px;font-weight:800}
@media(max-width:600px){.gm-benefits{grid-template-columns:1fr 1fr;padding:16px 13px;gap:10px}.gm-benefit{padding:12px 10px}.gm-benefit-icon{font-size:24px;min-width:30px}.gm-benefit-text b{font-size:11px}.gm-benefit-text small{font-size:9px}.gm-doctor-card{padding:25px 18px;flex-direction:column-reverse;text-align:center}.gm-doctor-content h2{font-size:25px}.gm-doctor-text{font-size:12px}.gm-doctor-image{width:100%;min-width:0}.gm-doctor-image img{width:160px;height:160px}}


/* GREEN MOON CONTACT / NAV FIX */
.gm-nav{position:relative;z-index:20}
.gm-nav-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:flex-start;gap:12px;padding:10px 20px!important;border-bottom:0!important}
.gm-contact-nav{display:inline-flex!important;align-items:center;justify-content:center;color:#fff!important;text-decoration:none!important;background:linear-gradient(135deg,#126044,#0d4935)!important;padding:12px 26px!important;border-radius:999px!important;border:1px solid rgba(224,199,126,.38)!important;box-shadow:0 6px 18px rgba(0,0,0,.14);font-weight:800!important;white-space:nowrap}
.gm-contact-nav:hover{background:#c9a85b!important;color:#092d22!important}
.gm-contact-card{background:linear-gradient(135deg,#061c15,#0d4935);color:#fff;border-radius:28px;padding:35px 24px;box-shadow:0 18px 50px rgba(6,28,21,.18);border:1px solid rgba(224,199,126,.25)}
.gm-contact-head{text-align:center;margin-bottom:25px}
.gm-contact-head span{color:#e0c77e;font-size:11px;font-weight:800;letter-spacing:2px}
.gm-contact-head h2{margin:6px 0;color:#fff;font-family:'Playfair Display',Cairo,serif;font-size:30px}
.gm-contact-head p{color:#c9d4ce;margin:0;line-height:1.9}
.gm-contact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.gm-contact-item{display:flex;align-items:center;gap:12px;padding:16px;border-radius:18px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);color:#fff!important;text-decoration:none!important;transition:.2s}
.gm-contact-item:hover{background:rgba(224,199,126,.15);transform:translateY(-2px)}
.gm-contact-item.is-disabled{opacity:.55;cursor:default}
.gm-contact-item.is-disabled:hover{background:rgba(255,255,255,.08);transform:none}
.gm-contact-icon{width:48px;height:48px;min-width:48px;border-radius:14px;background:#e0c77e;color:#092d22;display:flex;align-items:center;justify-content:center;font-size:21px;font-weight:900}
.gm-contact-item b{display:block;font-size:14px}
.gm-contact-item small{display:block;color:#bfcac4;margin-top:3px;line-height:1.5}
@media(max-width:900px){.gm-contact-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.gm-nav-inner{padding:8px 12px!important}.gm-contact-nav{padding:10px 20px!important;font-size:12px!important}.gm-contact-grid{grid-template-columns:1fr}.gm-contact-card{padding:26px 15px;border-radius:22px}.gm-contact-head h2{font-size:24px}}


/* ===== GREEN MOON LUXURY MOBILE V2 ===== */
.gm-luxury-hero{background:radial-gradient(circle at 75% 20%,rgba(224,199,126,.14),transparent 28%),linear-gradient(145deg,#041c14 0%,#073b29 55%,#0a4c35 100%)!important;height:390px!important;min-height:390px!important;border-radius:0 0 30px 30px;box-shadow:0 16px 35px rgba(6,28,21,.18)}
.gm-luxury-hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 18% 75%,rgba(201,168,91,.13),transparent 24%),linear-gradient(90deg,transparent 50%,rgba(255,255,255,.025));pointer-events:none}
.gm-luxury-hero:after{content:"";position:absolute;right:-90px;bottom:-110px;width:280px;height:280px;border:1px solid rgba(224,199,126,.22);border-radius:50%;box-shadow:0 0 0 24px rgba(224,199,126,.025),0 0 0 48px rgba(224,199,126,.02)}
.gm-luxury-hero .gm-hero-content{display:flex!important;align-items:center!important;justify-content:center!important;text-align:center!important;padding:30px 22px 70px!important;position:relative;z-index:3}
.gm-luxury-kicker{font-size:9px;letter-spacing:2.5px;color:#e0c77e;font-weight:800;margin-bottom:14px}
.gm-luxury-hero .gm-hero-content h1{font-family:Cairo,Tahoma,sans-serif!important;font-size:38px!important;line-height:1.25!important;max-width:100%!important;margin:0 0 10px!important;color:#fff!important}
.gm-luxury-hero .gm-hero-content h1::first-letter{color:#e0c77e}
.gm-luxury-hero .gm-hero-content p{font-size:14px!important;line-height:1.9!important;max-width:310px!important;margin:0 auto 20px!important;color:#e9eee9!important}
.gm-luxury-hero .gm-hero-btn{padding:12px 28px!important;font-size:14px!important;min-width:150px;justify-content:center}
.gm-luxury-hero .gm-hero-btn span{font-size:18px}
.gm-hero-botanical{position:absolute;z-index:2;color:rgba(224,199,126,.5);font-size:48px}.botanical-a{left:25px;top:55px}.botanical-b{right:22px;bottom:75px;font-size:58px;transform:rotate(-25deg);opacity:.35}
