#rewards{padding:0 13px!important;margin:12px 0!important}.rewards-card{border-radius:20px!important;padding:14px!important}.rewards-title{font-size:18px!important}.reward-grid{grid-template-columns:1fr!important}.reward{border-radius:14px!important}
#contact{padding:25px 13px!important;margin:0!important}.gm-contact-card{border-radius:22px!important;padding:22px 14px!important}.gm-contact-grid{grid-template-columns:1fr 1fr!important;gap:8px!important}.gm-contact-item{padding:10px!important;border-radius:14px!important;gap:8px!important}.gm-contact-icon{width:36px!important;height:36px!important;min-width:36px!important;border-radius:10px!important;font-size:16px!important}.gm-contact-item b{font-size:10px!important}.gm-contact-item small{font-size:8px!important}
footer{margin-top:0!important;padding:35px 15px 85px!important}footer h2{font-size:21px!important}
.gm-mobile-bottom{position:fixed;bottom:0;left:0;right:0;height:66px;background:rgba(255,253,248,.97);backdrop-filter:blur(16px);border-top:1px solid #e5dfd2;display:flex;justify-content:space-around;align-items:center;z-index:100;padding:5px 4px;box-shadow:0 -7px 22px rgba(17,43,34,.08)}.gm-mobile-bottom a{flex:1;text-decoration:none;color:#718079;text-align:center;font-size:8px;font-weight:700}.gm-mobile-bottom a span{display:block;font-size:20px;line-height:23px}.gm-mobile-bottom a.active,.gm-mobile-bottom a:hover{color:#092d22}.gm-mobile-bottom a.active span{color:#08783f}.gm-mobile-bottom b{font-size:9px}.gm-bottom-cart{position:relative}.gm-bottom-cart em{position:absolute;top:-6px;right:20%;background:#d6a944;color:#092d22;border-radius:50%;min-width:16px;height:16px;font-size:9px;font-style:normal;line-height:16px}
.gm-amazon-header{box-shadow:0 4px 16px rgba(0,0,0,.16)!important}.gm-topbar{display:none!important}.gm-mainbar{min-height:66px!important;padding:8px 12px!important;display:grid!important;grid-template-columns:38px 1fr auto!important;grid-template-areas:"menu brand cart"!important;gap:8px!important;align-items:center!important}.gm-brand{grid-area:brand!important;justify-content:center!important;min-width:0!important}.gm-brand-logo{width:42px!important;height:42px!important}.gm-brand-text{display:block!important;text-align:center}.gm-brand-name{font-size:15px!important}.gm-owner,.gm-tagline{display:none!important}.gm-search{display:none!important}.gm-head-actions{grid-area:cart!important}.gm-head-action:first-child{display:none!important}.gm-head-action{font-size:0!important;padding:0!important}.gm-head-action .ico{font-size:24px!important;margin:0!important}.gm-cart-count{top:-20px!important}.gm-mainbar:before{content:"☰";grid-area:menu;font-size:25px;color:#fff;display:flex;align-items:center;justify-content:center}
.gm-nav{display:none!important}
.doctor-launch{width:54px!important;height:54px!important;right:10px!important;bottom:76px!important}
@media(min-width:601px){.gm-mobile-shop-tools,.gm-mobile-bottom{display:none!important}.gm-luxury-hero{height:420px!important}.gm-luxury-hero .gm-hero-content{display:flex!important}.gm-hero-botanical,.gm-hero-trust{display:none!important}}

</style>
</head>
<body>


<header class="gm-amazon-header">

  <div class="gm-topbar">
    <div>
      <span>🚚 الشحن في جميع محافظات مصر</span>
      <span>💬 تواصل معنا</span>
    </div>
    <div>
      <span>❓ المساعدة</span>
      <span>🇪🇬 EGP⌄</span>
    </div>
  </div>

  <div class="gm-mainbar">

    <div class="gm-brand">
      <img id="siteLogo"
           class="gm-brand-logo"
           src="/assets/logo.jpg"
           alt="Green Moon">

      <div class="gm-brand-text">
        <span class="gm-brand-name" id="headerName">
          Green Moon Plants & Flowers
        </span>

        <span class="gm-owner">
          Mohamed Elgarhy
        </span>

        <span class="gm-tagline">
          🌿 نباتات أكتر.. حياة أجمل
        </span>
      </div>
    </div>

    <div class="gm-search">
      <input
        id="headerSearch"
        type="text"
        placeholder="ابحث عن نباتات، قصاري، مستلزمات..."
        oninput="$('search').value=this.value;renderProducts()">

      <button type="button"
        onclick="$('products').scrollIntoView({behavior:'smooth'})">
        🔍
      </button>
    </div>

    <div class="gm-head-actions">

      <button class="gm-head-action" type="button">
        <span class="ico">♡</span>
        المفضلة
      </button>

      <button class="gm-head-action" type="button" onclick="openCart()">
        <span class="ico">
          🛒
          <b class="gm-cart-count" id="cartCount">0</b>
        </span>
        السلة
      </button>

    </div>

  </div>

  <nav class="gm-nav">
    <div class="gm-nav-inner">

      <a class="gm-contact-nav" href="#contact">💬 تواصل معنا</a>

    </div>
  </nav>

</header>



<section class="gm-hero gm-luxury-hero" aria-label="Green Moon hero">
  <div class="gm-hero-botanical botanical-a">✦</div>
  <div class="gm-hero-botanical botanical-b">🌿</div>
  <div class="gm-hero-content">
    <span class="gm-luxury-kicker">GREEN MOON · PLANTS & FLOWERS</span>
    <h1 id="heroTitle">خلي بيتك مليان حياة</h1>
    <p id="heroSubtitle">نباتات طبيعية عالية الجودة لبيت أجمل وحياة أفضل 🌿</p>
    <a class="gm-hero-btn" href="#products">تسوق الآن <span>←</span></a>
  </div>
  <div class="gm-hero-trust">
    <span>🌱 نباتات مختارة</span><i></i><span>🚚 توصيل سريع</span><i></i><span>✓ جودة مضمونة</span>
  </div>
</section>
<section class="rewards" id="rewards">
  <div class="rewards-card">
    <div class="rewards-head">
      <div>
        <div class="rewards-title">✨ مكافآت Green Moon</div>
        <div class="rewards-sub" id="rewardsSub">
          كل ما تكمل طلبك، مكافأتك تقرب أكتر 💚
        </div>
      </div>
      <div class="rewards-sub" id="rewardsStatus">ابدأ التسوق</div>
    </div>

    <div class="reward-grid" id="rewardGrid"></div>
  </div>
</section> 

<section class="gm-mobile-shop-tools">
  <div class="gm-mobile-search">
    <span>⌕</span><input id="search" placeholder="ابحث عن نبات، قصارية، بامبو..." oninput="renderProducts()"><b>بحث</b>
  </div>
  <div class="gm-mobile-section-head"><div><small>اكتشف مجموعتنا</small><h2>تسوق حسب الفئة</h2></div><a href="#products">عرض الكل</a></div>
  <div id="categories" class="categories gm-category-strip"></div>
</section>

<section class="section" id="deals">
<div class="deals-head"><h2>🔥 صفقات Green Moon</h2><b>صفقة ورا صفقة… الفرصة مبتستناش!</b><p>عروض حصرية بتتجدد تلقائيًا ⏳</p></div>
<div id="dealsContainer" class="empty" style="padding:30px;text-align:center">جاري تحميل الصفقات...</div>
</section>

  <section class="gm-benefits">
  <div class="gm-benefits-inner">

    <div class="gm-benefit">
      <div class="gm-benefit-icon">🚚</div>
      <div class="gm-benefit-text">
        <b>توصيل لحد باب البيت</b>
        <small>احسب تكلفة الشحن قبل الطلب</small>
      </div>
    </div>

    <div class="gm-benefit">
      <div class="gm-benefit-icon">🌱</div>
      <div class="gm-benefit-text">
        <b>نباتات مختارة بعناية</b>
        <small>جودة نهتم بيها</small>
      </div>
    </div>

    <div class="gm-benefit">
      <div class="gm-benefit-icon">💚</div>
      <div class="gm-benefit-text">
        <b>مساعدة في اختيار نباتك</b>
        <small>Green Moon Doctor</small>
      </div>
    </div>

    <div class="gm-benefit">
      <div class="gm-benefit-icon">🔒</div>
      <div class="gm-benefit-text">
        <b>طلب آمن وسهل</b>
        <small>اطلب من Green Moon بسهولة</small>
      </div>
    </div>

  </div>
</section>

<section class="section" id="products">
<div class="gm-products-head"><div><span class="gm-products-kicker">GREEN MOON STORE</span><h2>🌿 منتجات Green Moon</h2><p>اختار نباتك المفضل واستمتع بتجربة تسوق سهلة وسريعة 💚</p></div><a href="#products" class="gm-view-all">عرض الكل ←</a></div>


<div id="productGrid" class="products">جاري تحميل المنتجات...</div>
</section>
<section class="section"><div class="gm-doctor-card"><div class="gm-doctor-content"><span class="gm-doctor-kicker">GREEN MOON AI</span><h2>🌿 Green Moon Doctor</h2><p class="gm-doctor-title">دكتور النباتات بتاعك</p><p class="gm-doctor-text">عندك مشكلة في نباتك؟ 📸<br>ابعت صورة واضحة للنبات وخلي Green Moon Doctor يساعدك في معرفة المشكلة والعناية المناسبة.</p><button class="gm-doctor-btn" onclick="openDoctor()">🔬 افحص نباتك الآن</button></div><div class="gm-doctor-image"><img src="/assets/green-moon-doctor.png" alt="Green Moon Doctor"><div class="gm-doctor-badge">🌱 مساعدك في العناية</div></div></div></section>
<section class="section" id="articles">
  <div class="gm-products-head">
    <div>
      <span class="gm-products-kicker">GREEN MOON MAGAZINE</span>
      <h2>📖 مقالات ونصائح</h2>
      <p>كل اللي محتاج تعرفه عن نباتاتك والعناية بيها 🌿</p>
    </div>

    <a href="#articles" class="gm-view-all">
      كل المقالات ←
    </a>
  </div>

  <div id="articlesGrid" class="articles"></div>
</section> 

<section class="section" id="contact">
  <div class="gm-contact-card">
    <div class="gm-contact-head">
      <span>GREEN MOON</span>
      <h2 id="contactTitle">تواصل مع Green Moon 🌿</h2>
      <p id="contactSubtitle">خليك قريب من Green Moon — إحنا هنا علشان نساعدك.</p>
    </div>
    <div class="gm-contact-grid">
      <a class="gm-contact-item" id="contactAddress" href="#" target="_blank" rel="noopener"><span class="gm-contact-icon">📍</span><span><b>العنوان</b><small id="contactAddressText">الدقي - داخل المتحف الزراعي - جناح Green Moon</small></span></a>
      <a class="gm-contact-item" id="contactPhone" href="#"><span class="gm-contact-icon">☎️</span><span><b>الهاتف</b><small id="contactPhoneText">01002048193</small></span></a>
      <a class="gm-contact-item" id="contactWhatsapp" href="#" target="_blank" rel="noopener"><span class="gm-contact-icon">💬</span><span><b>واتساب</b><small>تواصل معنا مباشرة</small></span></a>
      <a class="gm-contact-item" id="contactFacebook" href="#" target="_blank" rel="noopener"><span class="gm-contact-icon">f</span><span><b>Facebook</b><small>صفحتنا على فيسبوك</small></span></a>
      <a class="gm-contact-item" id="contactInstagram" href="#" target="_blank" rel="noopener"><span class="gm-contact-icon">◎</span><span><b>Instagram</b><small>تابعنا على إنستجرام</small></span></a>
      <a class="gm-contact-item" id="contactTikTok" href="#" target="_blank" rel="noopener"><span class="gm-contact-icon">♪</span><span><b>TikTok</b><small>شوف جديدنا</small></span></a>
      <a class="gm-contact-item" id="contactTwitter" href="#" target="_blank" rel="noopener"><span class="gm-contact-icon">𝕏</span><span><b>X / Twitter</b><small>تابع أخبارنا</small></span></a>
      <a class="gm-contact-item" id="contactEmail" href="#"><span class="gm-contact-icon">✉</span><span><b>البريد الإلكتروني</b><small id="contactEmailText">تواصل معنا عبر البريد</small></span></a>
    </div>
  </div>
</section>

<footer><h2>Green Moon Plants & Flowers</h2><p>نباتات أكتر.. حياة أجمل 🌿</p></footer>

<button class="doctor-launch" onclick="openDoctor()" aria-label="Green Moon Doctor">
  <img src="/assets/green-moon-doctor.png" alt="Green Moon Doctor">
  <span>دكتور</span>
</button>

<nav class="gm-mobile-bottom">
  <a href="#greenMoonHero" class="active"><span>⌂</span><b>الرئيسية</b></a>
  <a href="#products"><span>♧</span><b>المنتجات</b></a>
  <a href="#" onclick="openCart();return false"><span class="gm-bottom-cart">🛒<em id="mobileCartCount">0</em></span><b>السلة</b></a>
  <a href="#articles"><span>▤</span><b>المقالات</b></a>
  <a href="#contact"><span>◉</span><b>تواصل معنا</b></a>
</nav>

<div id="cartModal" class="modal hidden"><div class="box"><button class="close" onclick="closeCart()">×</button><h2>🛒 سلة المشتريات</h2><div id="cartItems"></div>
<div id="freeShippingMsg"></div><div id="giftMsg"></div>
<div class="total">إجمالي المنتجات: <b id="productsTotal">0</b> ج<br>التوصيل: <b id="shippingTotal">0</b> ج<br><b>الإجمالي النهائي: <span id="finalTotal">0</span> ج</b></div>
<h3>بيانات الطلب</h3><div class="form"><input id="customerName" placeholder="الاسم"><input id="customerPhone" placeholder="رقم الهاتف"><input id="customerGovernorate" placeholder="المحافظة"><input id="customerArea" placeholder="المنطقة"><input id="customerStreet" placeholder="الشارع"><input id="customerBuilding" placeholder="رقم المبنى"><input id="customerFloor" placeholder="الدور"><input id="customerApartment" placeholder="رقم الشقة"><textarea id="customerNotes" placeholder="ملاحظات"></textarea></div>
<button class="full" onclick="sendOrder()">تأكيد الطلب</button><p id="orderMsg"></p></div></div>

<div id="upsellModal" class="modal hidden"><div class="box"><button class="close" onclick="closeUpsell()">×</button><h2 id="upsellTitleView">🌿 استنى! ممكن تكمل نباتتك 👀</h2><p id="upsellMessageView">ضيف حاجة كمان لطلبك واستفيد من توصيل واحد 💚</p><div id="upsellList" class="upsell-list"></div><button class="full" onclick="closeUpsell()">كمل الطلب 🛒</button></div></div>

<div id="articleModal" class="modal hidden"><div class="box"><button class="close" onclick="closeArticle()">×</button><img id="articleImage" style="width:100%;border-radius:15px"><h2 id="articleTitle"></h2><div id="articleContent" style="line-height:2;white-space:pre-line"></div></div></div>
<div id="doctorModal" class="modal hidden"><div class="box">
<button class="close" onclick="closeDoctor()">×</button>
<div class="doctor-brand"><img src="/assets/green-moon-doctor.png" alt="Green Moon Doctor"><div><h2 style="margin:0">Green Moon Doctor</h2><small>دكتور النباتات 🌿</small></div></div>
<p>ارفع صورة واضحة للنبات والأعراض الظاهرة عليه.</p>
<input type="file" accept="image/*" id="doctorImage">
<img id="doctorPreview" style="width:100%;display:none;margin-top:15px;border-radius:15px">
<button id="doctorAnalyzeBtn" class="doctor-analyze-btn" type="button" onclick="analyzePlant()" disabled>
🔬 حلّل النبات
</button>
<div id="doctorStatus" class="doctor-status"></div>

<div class="doctor-note">⚠️ النتيجة الإرشادية لا تُعتبر تشخيصًا مؤكدًا من الصورة وحدها؛ أي توصية علاجية يجب أن تعتمد على مصادر زراعية موثوقة، وإذا كانت الصورة غير كافية سنطلب معلومات إضافية بدل التخمين.</div>
</div></div>


<div id="productModal" class="modal hidden">
  <div class="box">
    <button class="close" onclick="closeProduct()">×</button>
    <img id="productDetailImage" class="detail-image" src="/assets/logo.jpg" alt="">
    <h2 id="productDetailName"></h2>
    <div id="productDetailPrice" class="detail-price"></div>
    <div id="productDetailInfo" class="detail-info"></div>
    <div class="product-qty">
      <button onclick="detailQty(-1)">−</button>
      <span id="detailQtyValue">1</span>
      <button onclick="detailQty(1)">+</button>
    </div>
    <div class="detail-actions">
      <button class="full" onclick="addDetailToCart()">🛒 أضف للسلة</button>
      <button class="share-copy" onclick="shareCurrentProduct()">🔗 مشاركة المنتج</button>
    </div>
    <p id="shareMsg" style="text-align:center;color:#65766d"></p>
  </div>
</div>

<script>
let settings={},products=[],cart=[],category="";
const $=x=>document.getElementById(x);
const esc=x=>String(x??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
const escjs=x=>String(x??'').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
async function get(u){let r=await fetch(u);if(!r.ok)throw Error();return r.json()}

function syncMobileCart(){const e=$('mobileCartCount');if(e)e.textContent=cart.reduce((n,i)=>n+(i.qty||0),0)}
setInterval(syncMobileCart,500);
async function load(){
 try{
  settings=await get('/api/settings');products=await get('/api/products');
  if(!Array.isArray(products))products=[];
  apply();renderCategories();renderProducts();renderArticles();updateCart();renderDeals();updateRewards();openSharedProduct();
 }catch(e){$('productGrid').textContent='حدث خطأ أثناء تحميل المنتجات.'}
}
function apply(){
 if(settings.storeName){$('headerName').textContent=settings.storeName;document.title=settings.storeName}
 if(settings.logo)$('siteLogo').src=settings.logo;
 if(settings.title)$('heroTitle').textContent=settings.title;
 if(settings.subtitle)$('heroSubtitle').textContent=settings.subtitle;
 
}
function renderCategories(){
 let a=Array.isArray(settings.categories)?settings.categories:[];
 $('categories').innerHTML='<button class="cat" onclick="filterCat(\'\')">🌿<br><strong>الكل</strong></button>'+
 a.map(c=>'<button class="cat" onclick="filterCat(\''+encodeURIComponent(c.name||'')+'\')"><img src="'+(c.image||'/assets/logo.jpg')+'"><strong>'+esc(c.name||'')+'</strong></button>').join('')
}
function filterCat(c){category=decodeURIComponent(c);renderProducts()}
function productUrl(id){
 return location.origin+location.pathname+'?product='+encodeURIComponent(String(id))+'#products';
}
function productQuantity(id){
 let x=cart.find(x=>String(x.id)===String(id));
 return x?x.quantity:1;
}
function renderProducts(){
 let q=($('search').value||'').toLowerCase();
 let a=products.filter(p=>(!q||String(p.name||'').toLowerCase().includes(q)||String(p.category||'').toLowerCase().includes(q))&&(!category||p.category===category));
 $('productGrid').innerHTML=a.length?a.map(p=>{
   let qn=productQuantity(p.id);
   return '<div class="product">'+
     '<img src="'+(p.image||'/assets/logo.jpg')+'" alt="'+esc(p.name)+'" onclick="openProduct(\''+escjs(p.id)+'\')">'+
     '<div class="product-body"><h3>'+esc(p.name)+'</h3>'+
     '<div class="price">'+Number(p.price||0)+' ج</div>'+
     '<div class="product-qty"><button onclick="changeCardQty(\''+escjs(p.id)+'\',-1)">−</button><span id="cardQty_'+escjs(p.id)+'">'+qn+'</span><button onclick="changeCardQty(\''+escjs(p.id)+'\',1)">+</button></div>'+
     '<button style="margin-top:8px" onclick="addSelectedToCart(\''+escjs(p.id)+'\')">أضف للسلة 🛒</button>'+
     '<div class="product-actions">'+
     '<button class="details-btn" onclick="openProduct(\''+escjs(p.id)+'\')">🔎 التفاصيل</button>'+
     '<button class="share-btn" onclick="shareProduct(\''+escjs(p.id)+'\')">🔗 مشاركة</button>'+
     '</div></div></div>'
 }).join(''):'<p>لا توجد منتجات مطابقة.</p>'
}
function changeCardQty(id,n){
 let p=products.find(x=>String(x.id)===String(id));if(!p)return;
 let x=cart.find(x=>String(x.id)===String(id));
 let q=x?x.quantity:1;
 q=Math.max(1,q+n);
 if(x)x.quantity=q;
 let el=$('cardQty_'+String(id));if(el)el.textContent=q;
}
function addSelectedToCart(id){
 let p=products.find(x=>String(x.id)===String(id));if(!p)return;
 let el=$('cardQty_'+String(id)),q=Math.max(1,Number(el?.textContent||1));
 let x=cart.find(x=>String(x.id)===String(id));
 if(x)x.quantity+=q;else cart.push({id:p.id,name:p.name,price:Number(p.price||0),shippingPrice:Number(p.shippingPrice||0),image:p.image||'/assets/logo.jpg',quantity:q});
 updateCart();openCart();showUpsell(p.id);
 if(el)el.textContent=1;
}
let detailProductId=null,detailQuantity=1;
function openProduct(id){
 let p=products.find(x=>String(x.id)===String(id));if(!p)return;
 detailProductId=p.id;detailQuantity=1;
 $('productDetailImage').src=p.image||'/assets/logo.jpg';
 $('productDetailName').textContent=p.name||'';
 $('productDetailPrice').textContent=Number(p.price||0)+' ج';
 $('productDetailInfo').innerHTML=
   '<b>التفاصيل:</b><br>'+esc(p.details||p.description||'لا توجد تفاصيل إضافية.')+
   (p.care?'<br><br><b>العناية:</b><br>'+esc(p.care):'')+
   (p.shippingPrice!=null?'<br><br><b>الشحن:</b> '+Number(p.shippingPrice||0)+' ج':'');
 $('detailQtyValue').textContent=1;$('shareMsg').textContent='';
 $('productModal').classList.remove('hidden');
}
function closeProduct(){$('productModal').classList.add('hidden')}
function detailQty(n){detailQuantity=Math.max(1,detailQuantity+n);$('detailQtyValue').textContent=detailQuantity}
function addDetailToCart(){
 let p=products.find(x=>String(x.id)===String(detailProductId));if(!p)return;
 let x=cart.find(x=>String(x.id)===String(p.id));
 if(x)x.quantity+=detailQuantity;else cart.push({id:p.id,name:p.name,price:Number(p.price||0),shippingPrice:Number(p.shippingPrice||0),image:p.image||'/assets/logo.jpg',quantity:detailQuantity});
 updateCart();closeProduct();openCart();showUpsell(p.id);
}
async function shareProduct(id){
 let p=products.find(x=>String(x.id)===String(id));if(!p)return;
 let url=productUrl(p.id),text='شوف '+(p.name||'منتج Green Moon')+' من Green Moon Plants & Flowers 🌿';
 try{
   if(navigator.share){await navigator.share({title:p.name||'Green Moon',text,url});return}
 }catch(e){}
 try{await navigator.clipboard.writeText(url);alert('تم نسخ رابط المنتج 🔗')}
 catch(e){prompt('انسخ رابط المنتج:',url)}
}
async function shareCurrentProduct(){
 if(detailProductId!=null)await shareProduct(detailProductId);
}
/* إصلاح الصفقات:
   لو dealsStartAt ناقص/غير صالح، تبدأ السلسلة تلقائيًا من لحظة فتح المتجر.
   وكل صفقة تبدأ بعد انتهاء السابقة حسب مدتها.
*/
function schedule(){
 let a=Array.isArray(settings.deals)?settings.deals:[];
 if(!a.length)return[];

 // الصفقات تعمل في دورة مستمرة حتى لا تختفي من عند العميل
 let start=Date.parse(settings.dealsStartAt||'');
 if(!Number.isFinite(start)) start=Date.now();

 let durations=a.map(d=>Math.max(1,Number(d.durationMinutes)||1)*60000);
 let total=durations.reduce((s,v)=>s+v,0);
 let elapsed=Math.max(0,Date.now()-start);
 let cycleOffset=total?elapsed%total:0;

 let t=Date.now()-cycleOffset;
 return a.map((d,i)=>{
   let end=t+durations[i];
   let x={...d,_index:i,_start:t,_end:end};
   t=end;
   return x
 });
}

function renderDeals(){
 let a=schedule(),now=Date.now(),d=a.find(x=>now>=x._start&&now<x._end);
 if(!d){
   $('dealsContainer').innerHTML='<div style="padding:30px;text-align:center">🔥 جهزنا لك صفقة Green Moon حالياً</div>';
   return
 }
 let sec=Math.max(0,Math.ceil((d._end-now)/1000)),m=Math.floor(sec/60),s=sec%60;
 let old=Number(d.oldPrice)||0,price=Number(d.price)||0,off=old>price?Math.round((old-price)/old*100):0;
 $('dealsContainer').innerHTML='<div class="deal-card"><div class="deal-top"><img class="deal-image" src="'+(d.image||'/assets/logo.jpg')+'"><span class="deal-badge">🔥 صفقة الآن</span></div><div class="deal-body"><div class="deal-title">'+esc(d.title||'صفقة Green Moon')+'</div><p class="deal-desc">'+esc(d.description||'')+'</p><div class="prices"><span class="old">'+old+' جنيه</span><span class="new">'+price+' جنيه</span>'+(off?'<span class="discount">خصم '+off+'%</span>':'')+'</div><div class="timer"><div><b>'+String(m).padStart(2,'0')+'</b>دقيقة</div><div><b>'+String(s).padStart(2,'0')+'</b>ثانية</div></div><button class="deal-order" onclick="addDeal('+d._index+')">🛒 اطلب الصفقة الآن</button></div></div>'
}
if(!window.gmDealsTimer){
  window.gmDealsTimer=setInterval(renderDeals,1000);
}
  function updateRewards(){
  const grid=$("rewardGrid");
  const status=$("rewardsStatus");
  const sub=$("rewardsSub");

  if(!grid)return;

  const total=cart.reduce((s,x)=>s+x.price*x.quantity,0);
  const fs=settings.freeShipping||{};
  const g=settings.gifts||{};
  const items=[];

  if(fs.enabled!==false&&Number(fs.threshold)>0){
    items.push({
      type:"ship",
      threshold:Number(fs.threshold),
      title:"🚚 الشحن المجاني",
      icon:"🚚",
      done:total>=Number(fs.threshold),
      text:total>=Number(fs.threshold)
        ?"مبروك! الشحن مجاني على طلبك 🎉"
        :"فاضلك "+Math.max(0,Number(fs.threshold)-total)+" ج",
      action:"كمل طلبك ووصل للشحن المجاني"
    });
  }

  if(g.enabled!==false&&Number(g.threshold)>0){
    items.push({
      type:"gift",
      threshold:Number(g.threshold),
      title:g.name||"هدية Green Moon 🎁",
      image:g.image||"",
      icon:"🎁",
      done:total>=Number(g.threshold),
      text:total>=Number(g.threshold)
        ?(g.message||"مبروك! هديتك المجانية اتفتحت 🎉")
        :"فاضلك "+Math.max(0,Number(g.threshold)-total)+" ج عشان تفتح هديتك",
      action:"الهدية: "+(g.name||"هدية Green Moon")
    });
  }

  items.sort((a,b)=>a.threshold-b.threshold);

  const next=items.find(x=>!x.done);

  status.textContent=next
    ?"🔥 فاضلك "+Math.max(0,next.threshold-total)+" ج"
    :"🎉 كل المكافآت اتفتحت";

  sub.textContent=next
    ?"أنت قريب من "+next.title+" — كمّل طلبك وخد مكافأتك 💚"
    :"استمتع بمكافآتك مع Green Moon 💚";

  grid.innerHTML=items.map(r=>{
    const pct=Math.min(100,Math.round(total/r.threshold*100));

    return '<div class="reward '+(r.done?"done ":"")+(next&&next.type===r.type?"near":"")+'">'+
      '<div class="reward-media">'+
      (r.image?'<img src="'+esc(r.image)+'">':r.icon)+
      '</div>'+
      '<div class="reward-info">'+
      '<b>'+esc(r.title)+'</b>'+
      '<small>'+esc(r.text)+'</small>'+
      '<div class="reward-bar"><i style="width:'+pct+'%"></i></div>'+
      '<div class="reward-action">'+
      esc(r.action)+
      (r.done?' <span>✓ مفتوحة</span>':'')+
      '</div>'+
      '</div>'+
      '</div>';
  }).join("");
  }
function addToCart(id){
 let p=products.find(x=>String(x.id)===String(id));if(!p)return;
 let x=cart.find(x=>String(x.id)===String(id));
 if(x)x.quantity++;else cart.push({id:p.id,name:p.name,price:Number(p.price||0),shippingPrice:Number(p.shippingPrice||0),image:p.image||'/assets/logo.jpg',quantity:1});
 updateCart();updateRewards();openCart();showUpsell(p.id)
  }
function addDeal(i){
 let d=schedule()[i];
 if(!d||Date.now()<d._start||Date.now()>=d._end)return alert('الصفقة غير متاحة حاليًا.');
 let p=products.find(x=>String(x.id)===String(d.productId));if(!p)return;
 let x=cart.find(x=>String(x.id)===String(p.id));
 if(x){x.quantity++;x.price=Number(d.price||0)}
 else cart.push({id:p.id,name:p.name,price:Number(d.price||0),shippingPrice:Number(p.shippingPrice||0),image:p.image||'/assets/logo.jpg',quantity:1});
 updateCart();openCart();showUpsell(p.id)
}
function getCartTotals(){
 let pt=cart.reduce((s,x)=>s+x.price*x.quantity,0);
 let fs=settings.freeShipping||{};
 let free=fs.enabled!==false&&Number(fs.threshold)>0&&pt>=Number(fs.threshold);
 let ship=free?0:(cart.length===1?Number(cart[0].shippingPrice||0):Number(settings.shipping||0));
 let g=settings.gifts||{};
 let gift=g.enabled!==false&&Number(g.threshold)>0&&pt>=Number(g.threshold);
 return {pt,ship,total:pt+ship,free,gift}
}
function updateCart(){
 let n=cart.reduce((s,x)=>s+x.quantity,0);$('cartCount').textContent=n;
 if(!cart.length){$('cartItems').innerHTML='<p>السلة فارغة.</p>';$('productsTotal').textContent=$('shippingTotal').textContent=$('finalTotal').textContent=0;$('freeShippingMsg').innerHTML='';$('giftMsg').innerHTML='';return}
 $('cartItems').innerHTML=cart.map((x,i)=>'<div class="cart-item"><img src="'+x.image+'"><div class="info"><b>'+esc(x.name)+'</b><br>'+x.price+' ج</div><div class="qty"><button onclick="qty('+i+',-1)">−</button>'+x.quantity+'<button onclick="qty('+i+',1)">+</button></div></div>').join('');
 let t=getCartTotals();
 $('productsTotal').textContent=t.pt;$('shippingTotal').textContent=t.ship;$('finalTotal').textContent=t.total;
 $('freeShippingMsg').innerHTML=t.free?'<div class="free-msg">🚚 مبروك! الشحن أصبح مجانًا على طلبك 💚</div>':'';
 let g=settings.gifts||{};
 $('giftMsg').innerHTML=t.gift?'<div class="gift-msg">🎁 '+esc(g.message||'مبروك! حصلت على هدية مجانية')+'<br><b>'+esc(g.name||'هدية Green Moon')+' × '+(Number(g.qty)||1)+'</b></div>':''
}
function qty(i,n){cart[i].quantity+=n;if(cart[i].quantity<1)cart.splice(i,1);updateCart();updateRewards()}
function openCart(){$('cartModal').classList.remove('hidden');updateCart()}
function closeCart(){$('cartModal').classList.add('hidden')}
function showUpsell(id){
 let u=settings.upsell||{};
 if(u.enabled===false)return;
 let t=getCartTotals();if(t.pt<Number(u.minTotal||0))return;
 let ids=Array.isArray(u.productIds)?u.productIds.map(String):[];
 let a=ids.length?ids.map(id=>products.find(p=>String(p.id)===id)).filter(Boolean):products.filter(p=>String(p.id)!==String(id));
 a=a.filter(p=>String(p.id)!==String(id)).slice(0,Math.max(1,Number(u.limit)||3));if(!a.length)return;
 $('upsellTitleView').textContent=u.title||'🌿 استنى! ممكن تكمل نباتتك 👀';
 $('upsellMessageView').textContent=u.message||'ضيف حاجة كمان لطلبك واستفيد من توصيل واحد 💚';
 $('upsellList').innerHTML=a.map(p=>'<div class="upsell-item"><img src="'+(p.image||'/assets/logo.jpg')+'"><div><b>'+esc(p.name)+'</b><p>'+Number(p.price||0)+' ج</p><button class="upsell-add" onclick="addUpsell(\''+escjs(p.id)+'\')">+ أضف للسلة</button></div></div>').join('');
 $('upsellModal').classList.remove('hidden')
}
function addUpsell(id){let p=products.find(x=>String(x.id)===String(id));if(!p)return;let x=cart.find(x=>String(x.id)===String(id));if(x)x.quantity++;else cart.push({id:p.id,name:p.name,price:Number(p.price||0),shippingPrice:Number(p.shippingPrice||0),image:p.image||'/assets/logo.jpg',quantity:1});updateCart()}
function closeUpsell(){$('upsellModal').classList.add('hidden')}

async function sendOrder(){
 if(!cart.length)return $('orderMsg').textContent='السلة فارغة.';
 let name=$('customerName').value.trim(),phone=$('customerPhone').value.trim();
 if(!name||!phone)return $('orderMsg').textContent='من فضلك اكتب الاسم ورقم الهاتف.';
 let items=cart.map(x=>({productId:x.id,name:x.name,price:x.price,quantity:x.quantity,lineTotal:x.price*x.quantity}));
 let t=getCartTotals(),g=settings.gifts||{};
 let gifts=t.gift?[{name:g.name||'هدية Green Moon 🎁',quantity:Number(g.qty)||1,price:0,lineTotal:0}]:[];
 let body={name,phone,governorate:$('customerGovernorate').value,area:$('customerArea').value,street:$('customerStreet').value,building:$('customerBuilding').value,floor:$('customerFloor').value,apartment:$('customerApartment').value,notes:$('customerNotes').value,items,gifts,productsTotal:t.pt,shipping:t.ship,total:t.total};
 try{
  let r=await fetch('/api/orders',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),d=await r.json();
  if(!r.ok)throw Error(d.error||'فشل إرسال الطلب');
  $('orderMsg').textContent='تم إرسال طلبك بنجاح 💚';
  if(d.whatsappUrl)setTimeout(()=>open(d.whatsappUrl,'_blank'),500);
  cart=[];updateCart()
 }catch(e){$('orderMsg').textContent=e.message}
}
function renderArticles(){
 let a=Array.isArray(settings.articles)?settings.articles:[];
 $('articlesGrid').innerHTML=a.map((x,i)=>'<article class="article"><img src="'+(x.image||'/assets/logo.jpg')+'"><div class="article-body"><h3>'+esc(x.title||'مقال')+'</h3><p>'+esc(x.excerpt||'')+'</p><button class="gold" onclick="article('+i+')">اقرأ المقال</button></div></article>').join('')||'<p>لا توجد مقالات منشورة حاليًا.</p>'
}
function article(i){let a=settings.articles[i];$('articleImage').src=a.image||'/assets/logo.jpg';$('articleTitle').textContent=a.title||'';$('articleContent').textContent=a.content||a.excerpt||'';$('articleModal').classList.remove('hidden')}
function closeArticle(){$('articleModal').classList.add('hidden')}
function openDoctor(){$('doctorModal').classList.remove('hidden')}
function closeDoctor(){$('doctorModal').classList.add('hidden')}
$('doctorImage').onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{$('doctorPreview').src=r.result;$('doctorPreview').style.display='block'};r.readAsDataURL(f)}
function openSharedProduct(){
 let id=new URLSearchParams(location.search).get('product');
 if(!id)return;
 let p=products.find(x=>String(x.id)===String(id));
 if(p)setTimeout(()=>openProduct(p.id),350);
}
load();
</script>

<script>
function doctorImageReady(){
  const input=document.getElementById('doctorImage');
  const btn=document.getElementById('doctorAnalyzeBtn');
  const status=document.getElementById('doctorStatus');
  const preview=document.getElementById('doctorPreview');
  if(!input||!btn)return;

  input.addEventListener('change',()=>{
    const file=input.files&&input.files[0];
    btn.disabled=!file;

    if(file && preview){
      const reader=new FileReader();
      reader.onload=()=>{
        preview.src=reader.result;
        preview.style.display='block';
      };
      reader.readAsDataURL(file);
    }

    if(status){
      status.textContent=file
        ? 'الصورة جاهزة للفحص. اضغط «حلّل النبات» للبدء.'
        : '';
    }
  });
}

function doctorEscapeHtml(value){
  return String(value??'')
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#039;');
}

async function analyzePlant(){
  const input=document.getElementById('doctorImage');
  const btn=document.getElementById('doctorAnalyzeBtn');
  const status=document.getElementById('doctorStatus');

  if(!input||!input.files||!input.files[0])return;

  const file=input.files[0];

  btn.disabled=true;
  if(status){
    status.innerHTML='🔬 جاري تحليل صورة النبات...<br><small>قد يستغرق التحليل عدة ثوانٍ.</small>';
  }

  try{
    const imageData=await new Promise((resolve,reject)=>{
      const reader=new FileReader();
      reader.onload=()=>resolve(reader.result);
      reader.onerror=()=>reject(new Error('تعذر قراءة الصورة.'));
      reader.readAsDataURL(file);
    });

    const response=await fetch('/api/doctor/analyze',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({image:imageData})
    });

    let data={};
    try{
      data=await response.json();
    }catch(e){
      throw new Error('تعذر قراءة نتيجة التحليل من الخادم.');
    }

    if(!response.ok){
      throw new Error(data.error||'تعذر إجراء التحليل حاليًا.');
    }

    const result=String(data.result||'').trim();

    if(!result){
      throw new Error('لم يتم الحصول على نتيجة تحليل.');
    }

    if(status){
      status.style.textAlign='right';
      status.innerHTML=
        '<div style="background:#f7f3e9;border:1px solid var(--line);padding:16px;border-radius:16px;line-height:2;white-space:pre-wrap;">'
        +doctorEscapeHtml(result)+
        '</div>';
    }

  }catch(error){
    if(status){
      status.style.textAlign='center';
      status.innerHTML=
        '<div style="background:#fff0ee;border:1px solid #efd0c9;padding:14px;border-radius:14px;color:#8b3f34;">'
        +'⚠️ '+doctorEscapeHtml(error?.message||'حدث خطأ أثناء التحليل.')
        +'</div>';
    }
  }finally{
    btn.disabled=false;
  }
}

document.addEventListener('DOMContentLoaded',doctorImageReady);

function cleanContactPhone(v){return String(v||'').replace(/[^0-9+]/g,'')}
function contactWhatsAppUrl(v){let n=String(v||'').replace(/[^0-9]/g,'');if(n.startsWith('0'))n='20'+n.slice(1);return n?'https://wa.me/'+n:''}
function renderContact(){
  const c=(typeof settings!=='undefined'&&settings.contact)||{};
  const set=(id,v)=>{const e=$(id);if(e)e.textContent=v};
  set('contactTitle',c.title||'تواصل مع Green Moon 🌿');
  set('contactSubtitle',c.subtitle||'خليك قريب من Green Moon — إحنا هنا علشان نساعدك.');
  set('contactAddressText',c.address||'الدقي - داخل المتحف الزراعي - جناح Green Moon');
  set('contactPhoneText',c.phone||'01002048193');
  set('contactEmailText',c.email||'تواصل معنا عبر البريد');
  const link=(id,url)=>{const e=$(id);if(!e)return;const ok=!!url&&url!=='#';e.href=ok?url:'#';e.classList.toggle('is-disabled',!ok);e.onclick=ok?null:(ev=>ev.preventDefault());};
  link('contactAddress',c.map||'');
  link('contactPhone',c.phone?'tel:'+cleanContactPhone(c.phone):'tel:01002048193');
  link('contactWhatsapp',c.whatsapp?contactWhatsAppUrl(c.whatsapp):contactWhatsAppUrl('01151054863'));
  link('contactFacebook',c.facebook||'');
  link('contactInstagram',c.instagram||'');
  link('contactTikTok',c.tiktok||'');
  link('contactTwitter',c.twitter||'');
  link('contactEmail',c.email?'mailto:'+c.email:'');
}

</script>

<script>document.addEventListener("DOMContentLoaded",()=>{try{renderContact()}catch(e){}});</script>
</body>
</html>
