<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Green Moon Plants & Flowers</title>



<style>

  .rewards{max-width:1280px;margin:24px auto 8px;padding:0 18px}
.rewards-card{background:linear-gradient(135deg,#fffdf8,#f4eee0);border:1px solid rgba(201,168,91,.35);border-radius:26px;padding:20px;box-shadow:0 18px 55px rgba(17,43,34,.08)}
.rewards-head{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:14px}
.rewards-title{font-family:'Playfair Display',Cairo,serif;font-size:25px;font-weight:700;color:var(--green)}
.rewards-sub{color:var(--muted);font-size:12px}
.reward-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.reward{display:flex;gap:12px;align-items:center;background:rgba(255,255,255,.72);border:1px solid var(--line);border-radius:18px;padding:12px;transition:.2s}
.reward.near{border-color:rgba(201,168,91,.75);box-shadow:0 8px 24px rgba(201,168,91,.12)}
.reward.done{background:#edf6ef}
.reward-media{width:62px;height:62px;min-width:62px;border-radius:15px;background:#eee7d8;display:flex;align-items:center;justify-content:center;font-size:28px;overflow:hidden}
.reward-media img{width:100%;height:100%;object-fit:cover}
.reward-info{flex:1;min-width:0}
.reward-info b{display:block;font-size:13px}
.reward-info small{display:block;color:var(--muted);margin:3px 0 7px;line-height:1.6}
.reward-bar{height:7px;background:#e3ded2;border-radius:99px;overflow:hidden}
.reward-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--green2),var(--gold));border-radius:99px}
.reward-action{font-size:10px;color:#66756e;margin-top:6px}
.reward-action span{color:#14743f;font-weight:800;margin-right:5px}
@media(max-width:600px){
.rewards{padding:0 13px;margin:16px auto 4px}
.rewards-card{padding:14px;border-radius:20px}
.rewards-title{font-size:20px}
.rewards-head{align-items:flex-start}
.reward-grid{grid-template-columns:1fr}
.reward{padding:10px}
.reward-media{width:52px;height:52px;min-width:52px}
.reward-info b{font-size:12px}
}
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');
:root{--green:#092d22;--green2:#123f30;--deep:#061c15;--cream:#f5f0e5;--ivory:#fffdf8;--gold:#c9a85b;--gold2:#e0c77e;--muted:#78857e;--line:#e5dfd2}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font-family:Cairo,Tahoma,sans-serif;background:var(--cream);color:var(--green);padding-bottom:64px}
button,input,textarea,select{font:inherit}button{cursor:pointer;border:0}
header{position:sticky;top:0;z-index:50;background:rgba(6,28,21,.96);backdrop-filter:blur(18px);color:#fff;border-bottom:1px solid rgba(201,168,91,.2);padding:10px 16px}
.nav{max-width:1280px;margin:auto;display:flex;align-items:center;gap:14px}
.logo{width:46px;height:46px;border-radius:50%;object-fit:cover;border:1px solid rgba(224,199,126,.55)}
.brand{flex:1}.brand b{display:block;font-size:14px}.brand small{display:block;color:#bfcac4;font-size:10px}
.cart-btn,.gold{background:linear-gradient(135deg,var(--gold2),var(--gold));color:#142d24;padding:11px 16px;border-radius:999px;font-weight:700;box-shadow:0 8px 25px rgba(201,168,91,.16)}
.hero{height:78vh;min-height:520px;max-height:900px;position:relative;overflow:hidden;background:#071d16}
.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none;filter:saturate(.94) contrast(1.03)}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,18,13,.03),rgba(4,18,13,.12) 55%,rgba(4,18,13,.32))}
.hero-content{display:none!important}
.section{max-width:1280px;margin:54px auto;padding:0 18px}.center{text-align:center}
.section h2{font-family:'Playfair Display',Cairo,serif;font-size:32px;margin:0 0 8px}.section>.center p{color:var(--muted)}
.benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.benefit{background:rgba(255,253,248,.82);border:1px solid var(--line);border-radius:22px;padding:24px 16px;text-align:center;box-shadow:0 12px 35px rgba(17,43,34,.06);display:flex;flex-direction:column;gap:5px}
#deals{background:linear-gradient(180deg,#f7f2e8,#eee7d8);max-width:none;padding:58px 18px;margin:0}
.deals-head{text-align:center;max-width:700px;margin:0 auto 24px}
.deals-head h2{font-family:'Playfair Display',Cairo,serif;font-size:38px;color:var(--green);margin-bottom:4px}.deals-head p{color:var(--muted)}
.deal-card{
  max-width:1280px;
  margin:0 auto;
  background:transparent;
  border:0;
  border-radius:0;
  overflow:visible;
  box-shadow:none;
}

.deal-top{
  position:relative;
  border-radius:18px 18px 0 0;
  overflow:hidden;
  background:#fff;
}

.deal-image{
  width:100%;
  aspect-ratio:16/6;
  object-fit:cover;
  display:block;
}

.deal-badge{
  position:absolute;
  top:14px;
  right:14px;
  background:#e51d2a;
  color:#fff;
  padding:7px 13px;
  border-radius:8px;
  font-weight:800;
  font-size:12px;
}

.deal-body{
  background:#fff;
  padding:18px 20px 20px;
  border-radius:0 0 18px 18px;
  border:1px solid #e5dfd2;
  border-top:0;
}

.deal-title{
  font-family:Cairo,Tahoma,sans-serif;
  font-size:21px;
  font-weight:800;
  color:#092d22;
}

.deal-desc{
  color:#78857e;
  line-height:1.7;
  margin:5px 0 10px;
}

.prices{
  display:flex;
  align-items:center;
  gap:10px;
}

.old{
  text-decoration:line-through;
  color:#999;
  font-size:13px;
}

.new{
  font-size:25px;
  font-weight:900;
  color:#08783f;
}

.discount{
  background:#e51d2a;
  color:#fff;
  padding:4px 9px;
  border-radius:6px;
  font-size:11px;
  font-weight:800;
}

.timer{
  display:none;
}

.deal-order{
  margin-top:12px;
  background:#08783f;
  color:#fff;
  padding:12px 20px;
  border-radius:10px;
  font-weight:800;
}

@media(max-width:600px){
  .deal-image{
    aspect-ratio:16/8;
  }

  .deal-body{
    padding:14px;
  }

  .deal-title{
    font-size:17px;
  }

  .new{
    font-size:21px;
  }
  }

.deal-top{
  position:relative;
  border-radius:18px 18px 0 0;
  overflow:hidden;
  background:#fff;
}

.deal-image{
  width:100%;
  aspect-ratio:16/6;
  object-fit:cover;
  display:block;
}

.deal-badge{
  position:absolute;
