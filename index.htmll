  background:#e51d2a;
  color:#fff;
  padding:7px 13px;
  border-radius:8px;
  font-weight:800;
  font-size:12px;
}

.deal-body{
  background:#fff;
  padding:18px 20px 20px;
  border-radius:0 0 18px 18px;
  border:1px solid #e5dfd2;
  border-top:0;
}

.deal-title{
  font-family:Cairo,Tahoma,sans-serif;
  font-size:21px;
  font-weight:800;
  color:#092d22;
}

.deal-desc{
  color:#78857e;
  line-height:1.7;
  margin:5px 0 10px;
}

.prices{
  display:flex;
  align-items:center;
  gap:10px;
}

.old{
  text-decoration:line-through;
  color:#999;
