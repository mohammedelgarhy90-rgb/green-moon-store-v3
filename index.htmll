.gm-mobile-section-head{display:flex;align-items:end;justify-content:space-between;margin:22px 0 5px}.gm-mobile-section-head small{color:#c9a85b;font-weight:800;font-size:9px}.gm-mobile-section-head h2{margin:2px 0 0;font-size:21px;color:#092d22}.gm-mobile-section-head a{font-size:10px;color:#08783f;font-weight:800;text-decoration:none}
.gm-category-strip{gap:9px!important;padding:10px 1px 16px!important}.gm-category-strip .cat{flex:0 0 82px!important;min-width:82px!important;height:96px!important;border-radius:16px!important;padding:7px!important;background:#fff!important;box-shadow:0 7px 18px rgba(17,43,34,.07)!important}.gm-category-strip .cat img{width:55px!important;height:55px!important;border-radius:14px!important}.gm-category-strip .cat strong{font-size:9px!important;margin-top:5px!important}.gm-category-strip .cat:first-child{background:#092d22!important;border-color:#092d22!important}
#deals{margin:0!important;padding:28px 13px 25px!important;background:linear-gradient(180deg,#f7f3e9,#efe7d7)!important}.deals-head{text-align:right!important;margin:0 0 14px!important}.deals-head h2{font-size:24px!important;margin:0!important}.deals-head b{font-size:10px}.deals-head p{font-size:9px;margin:2px 0 0}.deal-card{border-radius:20px!important;overflow:hidden!important;box-shadow:0 10px 26px rgba(17,43,34,.09)!important;background:#fff!important}.deal-top{border-radius:0!important}.deal-image{aspect-ratio:1.35!important}.deal-body{padding:13px!important}.deal-title{font-size:15px!important}.deal-desc{font-size:10px!important;line-height:1.6!important}.prices{gap:7px!important}.old{font-size:10px}.new{font-size:20px!important}.discount{font-size:9px;padding:4px 8px}.deal-order{width:100%!important;padding:10px!important;border-radius:11px!important;font-size:11px}.timer{display:none!important}
.gm-benefits{display:grid!important;grid-template-columns:1fr 1fr!important;padding:12px 13px!important;gap:8px!important}.gm-benefit{border-radius:15px!important;padding:10px 8px!important;box-shadow:0 5px 15px rgba(17,43,34,.05)!important}.gm-benefit-icon{font-size:20px!important;min-width:26px!important}.gm-benefit-text b{font-size:9px!important}.gm-benefit-text small{font-size:8px!important}
#products{margin:0!important;padding:26px 13px!important}.gm-products-head{display:flex!important;justify-content:space-between!important;align-items:flex-end!important;margin-bottom:12px!important}.gm-products-kicker{font-size:8px!important}.gm-products-head h2{font-size:21px!important}.gm-products-head p{font-size:9px!important;max-width:230px}.gm-view-all{font-size:9px!important;padding:7px 10px!important;border-radius:10px!important}.products{grid-template-columns:repeat(2,1fr)!important;gap:9px!important}.product{border-radius:16px!important;box-shadow:0 5px 16px rgba(17,43,34,.07)!important}.product>img{aspect-ratio:1/1!important}.product-body{padding:9px!important}.product-body h3{font-size:11px!important;min-height:35px!important}.product-body .price{font-size:16px!important;margin:5px 0!important}.product-qty{margin-top:6px!important;border-radius:9px!important}.product-qty button{width:28px!important;height:28px!important;border-radius:7px!important}.product-qty span{font-size:11px}.product-actions{grid-template-columns:1fr!important;gap:5px!important}.product-actions .share-btn{display:none}.product-actions .details-btn{padding:8px!important;font-size:10px!important}.product-body>button{padding:9px!important;border-radius:9px!important;font-size:10px!important}
.gm-doctor-card{margin:4px 13px!important;padding:18px!important;border-radius:20px!important;gap:12px!important}.gm-doctor-content h2{font-size:22px!important}.gm-doctor-title{font-size:13px!important}.gm-doctor-text{font-size:10px!important;line-height:1.8!important}.gm-doctor-btn{font-size:11px!important;padding:10px 18px!important}.gm-doctor-image img{width:115px!important;height:115px!important}
